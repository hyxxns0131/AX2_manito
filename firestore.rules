rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null; }

    // 명단·설정: 누구나 읽기, 관리자만 쓰기
    match /people/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /settings/{doc}  { allow read: if true; allow write: if isAdmin(); }

    // 로그인 키(= 이름+코드 해시) 문서: id를 아는 사람만 단건 조회, 목록 조회 금지
    match /keys/{key} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 코드·전체 배정 원본: 관리자 전용
    match /admin/{doc} { allow read, write: if isAdmin(); }

    // 프로필
    match /profiles/{id} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['likes', 'dislikes', 'allergy', 'updatedAt'])
                   && request.resource.data.likes.size() <= 100
                   && request.resource.data.dislikes.size() <= 100;
    }

    // 익명 대화: 대화방 id가 무작위라 받는 사람 쪽에선 보낸 사람이 드러나지 않음
    match /chats/{threadId} {
      allow read: if true;
      allow write: if isAdmin();
      match /items/{itemId} {
        allow read: if true;
        allow delete: if isAdmin();
        allow create: if request.resource.data.keys().hasOnly(['from', 'text', 'at'])
                      && request.resource.data.from in ['giver', 'receiver']
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 200;
      }
    }

    // 전체 배정 공개본: 관리자가 정한 정체 공개 시각 이후에만 읽기 가능
    match /reveal/{doc} {
      allow read: if request.time.toMillis() >=
        get(/databases/$(database)/documents/settings/main).data.finalRevealAt;
      allow write: if isAdmin();
    }
  }
}
