rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null; }

    // 명단·설정: 누구나 읽기, 관리자만 쓰기
    match /people/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /settings/{doc}  { allow read: if true; allow write: if isAdmin(); }

    // 로그인 키(= 이름+코드 해시) 문서: id를 아는 사람만 단건 조회, 목록 조회 금지
    match /keys/{key} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 코드·전체 배정 원본: 관리자 전용
    match /admin/{doc} { allow read, write: if isAdmin(); }

    // 프로필
    match /profiles/{id} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['likes', 'dislikes', 'allergy', 'updatedAt'])
                   && request.resource.data.likes.size() <= 100
                   && request.resource.data.dislikes.size() <= 100;
    }

    // 한마디: 문서 id가 보낸 사람 키의 해시라 보낸 사람이 드러나지 않음
    match /messages/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['toId', 'text', 'updatedAt'])
                            && request.resource.data.text.size() <= 200;
    }
  }
}
